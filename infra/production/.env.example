# Linux uses ':' between compose files. All paths are relative to this directory.
# Existing local Docker infrastructure + direct HTTP access:
COMPOSE_FILE=compose.yaml:compose.infra.yaml
COMPOSE_PATH_SEPARATOR=:
# Remote infrastructure: remove compose.infra.yaml above.
# Keep this stable across releases; it also identifies the upload volume.
COMPOSE_PROJECT_NAME=streamcell-app
INFRA_NETWORK=streamcell-net

# Image version label, applied to BOTH frontend and backend.
# First release: 20261016-1; next update: 20261016-2 (or use a reviewed Git SHA).
# deploy.sh builds these images; this tag does not have to exist beforehand.
IMAGE_PREFIX=streamcell
IMAGE_TAG=20261016-1

# Open http://SERVER_IP:8088. Change the port if it is already occupied.
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_HTTP_PORT=8088

# These must be reachable FROM THE BACKEND CONTAINER; localhost is the container.
# Use jdbc:postgresql:, NOT jdbc:log4jdbc:postgresql:, for the production driver.
POSTGRES_URL=jdbc:postgresql://postgres:5432/streamcell
POSTGRES_USERNAME=streamcell
POSTGRES_PASSWORD=replace-with-existing-db-password

# Flink connects to this URL itself. It may differ from POSTGRES_URL.
# This version of the application uses the same DB username/password for both.
FLINK_JDBC_URL=jdbc:postgresql://postgres:5432/streamcell

# These Kafka advertised addresses must resolve from BOTH backend AND Flink.
# No http:// prefix. For remote brokers use their reachable advertised listeners.
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
FLINK_JOB_MANAGER_URL=http://flink-jobmanager:8081
FLINK_SQL_GATEWAY=http://flink-sql-gateway:8083

ATLAS_URL=replace-with-atlas-url
ATLAS_AGENT_ID=replace-with-atlas-agent-id
ATLAS_API_KEY=replace-with-atlas-api-key

# init-env.py generates this without printing the key.
JWT_SECRET=replace-with-base64-jwt-secret
DB_POOL_SIZE=10
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPUS=1.0

# Quote values containing '$' with single quotes to prevent Compose interpolation.
# Never put secrets in VITE_* variables or Docker build arguments.
