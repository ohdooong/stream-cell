# Leave empty in local development to use Vite's /api proxy.
# For a separately deployed frontend, use the public API origin.
VITE_API_BASE_URL=

# Spring Security 연동 전에는 false로 유지합니다.
VITE_AUTH_ENABLED=false
VITE_DEFAULT_USER_ID=1

# Spring Security endpoints. These defaults can be changed without editing source.
VITE_AUTH_LOGIN_PATH=/api/v1/auth/login
VITE_AUTH_ME_PATH=/api/v1/auth/me
VITE_AUTH_LOGOUT_PATH=/api/v1/auth/logout

# Keep false outside local development. Local `npm run dev` uses .env.development instead.
VITE_DEMO_MODE=false

# Development proxy target
VITE_PROXY_TARGET=http://localhost:8085
