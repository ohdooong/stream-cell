# Leave empty in local development to use Vite's /api proxy.
# For a separately deployed frontend, use the public API origin.
VITE_API_BASE_URL=

# JWT 로그인을 사용합니다. 로컬 개발 사용자 모드에서만 false로 바꾸세요.
VITE_AUTH_ENABLED=true
VITE_DEFAULT_USER_ID=1

# Keep false outside local development. Local `npm run dev` uses .env.development instead.
VITE_DEMO_MODE=false

# Development proxy target
VITE_PROXY_TARGET=http://localhost:8085
